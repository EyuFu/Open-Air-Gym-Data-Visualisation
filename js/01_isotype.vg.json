{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 790,
  "height": 410,
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/ausplay2025_places_by_age_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'All adults' && datum.place == 'Public spaces (parks, streets, trails, beaches)' && datum.age != 'All ages'"
    },
    {
      "calculate": "round(datum.pct / 5)",
      "as": "figures"
    },
    {
      "calculate": "sequence(1, 21)",
      "as": "slots"
    },
    {
      "flatten": [
        "slots"
      ],
      "as": [
        "slot"
      ]
    },
    {
      "calculate": "datum.slot + floor((datum.slot - 1) / 5) * 0.7",
      "as": "xpos"
    },
    {
      "calculate": "datum.slot > datum.figures ? 'empty' : datum.age == '55–64' ? 'highlight' : 'other'",
      "as": "state"
    }
  ],
  "encoding": {
    "y": {
      "field": "age",
      "type": "nominal",
      "sort": [
        "15–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65 and over"
      ],
      "title": "Age group (years)",
      "scale": {
        "padding": 0.25
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelPadding": 8,
        "labelColor": "#1f2a30",
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == '55–64'",
            "value": 700
          },
          "value": 400
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M-0.28,-0.78 a0.28,0.28 0 1,0 0.56,0 a0.28,0.28 0 1,0 -0.56,0 M-0.42,1 L-0.42,-0.2 Q0,-0.45 0.42,-0.2 L0.42,1 Z",
        "size": 900,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              29.5
            ]
          },
          "axis": null
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "highlight",
              "other",
              "empty"
            ],
            "range": [
              "#3AA6D9",
              "#b9bec2",
              "#ecebe7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 180,
            "symbolStrokeWidth": 0,
            "gridAlign": "none",
            "columnPadding": 48,
            "offset": 16,
            "title": "Figure colour",
            "labelExpr": "{'highlight': 'Ages 55–64 (peak)', 'other': 'Other ages', 'empty': 'Not outdoors'}[datum.label]"
          }
        },
        "tooltip": [
          {
            "field": "age",
            "title": "Age group"
          },
          {
            "field": "pct",
            "title": "Share of adults (%)",
            "format": ".1f"
          }
        ]
      },
      "description": "One person icon per 5 adults out of 100; one row per age group, the sky-blue row is 55 to 64"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '55–64' && datum.slot == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + ' in 100'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "align": "left",
        "fontSize": 13,
        "color": "#1b78a8"
      },
      "encoding": {
        "x": {
          "datum": 23.8,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Bold sky-blue label at the end of the peak row: how many in 100 adults"
    },
    {
      "transform": [
        {
          "filter": "datum.age != '55–64' && datum.slot == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + ' in 100'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 400,
        "align": "left",
        "fontSize": 13,
        "color": "#5b6770"
      },
      "encoding": {
        "x": {
          "datum": 23.8,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Regular grey label at the end of the other rows"
    },
    {
      "transform": [
        {
          "filter": "datum.slot == 1 && datum.age == '55–64'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 27.4,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "More free time once their",
            "children leave home"
          ]
        }
      },
      "description": "Why note beside the peak row"
    },
    {
      "transform": [
        {
          "filter": "datum.slot == 1 && datum.age == '65 and over'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 27.4,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Poor health stops more",
            "people after 65 (chart 12)"
          ]
        }
      },
      "description": "Why note beside the 65 and over row"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 23,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Outdoor exercise rises with age and peaks at 55–64"
}