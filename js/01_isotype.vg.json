{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/ausplay2025_places_by_age_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'All adults' && datum.place == 'Public spaces (parks, streets, trails, beaches)'"
    },
    {
      "calculate": "datum.age == 'All ages' ? 'All ages (average)' : datum.age",
      "as": "row"
    },
    {
      "calculate": "round(datum.pct / 5)",
      "as": "figures"
    },
    {
      "calculate": "sequence(1, 21)",
      "as": "slots"
    },
    {
      "flatten": [
        "slots"
      ],
      "as": [
        "slot"
      ]
    },
    {
      "calculate": "datum.slot + floor((datum.slot - 1) / 5) * 0.7",
      "as": "xpos"
    },
    {
      "calculate": "datum.slot > datum.figures ? 'empty' : datum.row == '55–64' ? 'highlight' : datum.row == 'All ages (average)' ? 'all' : 'other'",
      "as": "state"
    }
  ],
  "encoding": {
    "y": {
      "field": "row",
      "type": "nominal",
      "sort": [
        "All ages (average)",
        "15–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65 and over"
      ],
      "title": null,
      "scale": {
        "padding": 0.25
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelPadding": 8,
        "labelColor": "#1f2a30",
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == '55–64' || datum.label == 'All ages (average)'",
            "value": 700
          },
          "value": 400
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M-0.28,-0.78 a0.28,0.28 0 1,0 0.56,0 a0.28,0.28 0 1,0 -0.56,0 M-0.42,1 L-0.42,-0.2 Q0,-0.45 0.42,-0.2 L0.42,1 Z",
        "size": 600,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              32.5
            ]
          },
          "axis": null
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "highlight",
              "all",
              "other",
              "empty"
            ],
            "range": [
              "#1b9e77",
              "#1f2a30",
              "#9aa1a6",
              "#ecebe7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 400,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 170,
            "symbolStrokeWidth": 0,
            "gridAlign": "all",
            "columnPadding": 80,
            "offset": 16,
            "title": "Figure colour",
            "labelExpr": "{'highlight': 'Ages 55–64 (peak)', 'all': 'All ages (average)', 'other': 'Other ages', 'empty': 'Not outdoors'}[datum.label]"
          }
        },
        "tooltip": [
          {
            "field": "row",
            "title": "Age group"
          },
          {
            "field": "pct",
            "title": "Share of adults (%)",
            "format": ".1f"
          }
        ]
      },
      "description": "One person icon per 5 adults out of 100; one row per age group, the teal row is 55 to 64"
    },
    {
      "transform": [
        {
          "filter": "datum.row == '55–64' || datum.row == 'All ages (average)'"
        },
        {
          "filter": "datum.slot == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + ' in 100'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "align": "left",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "datum": 23.8,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.row == '55–64'",
            "value": "#1b9e77"
          },
          "value": "#5b6770"
        }
      },
      "description": "Bold label at the end of the two key rows (peak and the all-ages average): how many in 100 adults"
    },
    {
      "transform": [
        {
          "filter": "!(datum.row == '55–64' || datum.row == 'All ages (average)')"
        },
        {
          "filter": "datum.slot == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + ' in 100'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 400,
        "align": "left",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "datum": 23.8,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.row == '55–64'",
            "value": "#1b9e77"
          },
          "value": "#5b6770"
        }
      },
      "description": "Regular label at the end of the other rows"
    },
    {
      "transform": [
        {
          "filter": "datum.slot == 1 && datum.row == '55–64'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 12,
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "datum": 27.4,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "More free time once",
            "children leave home"
          ]
        }
      },
      "description": "Why note beside the peak row"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 8,
      "right": 20,
      "top": 8,
      "bottom": 8
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 12,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Outdoor exercise rises with age and peaks at 55 to 64",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}