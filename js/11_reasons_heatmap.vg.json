{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 690,
  "height": 360,
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/ausplay2025_motivations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "resolve": {
    "scale": {
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'All adults' && datum.age != 'All ages'"
    },
    {
      "filter": {
        "field": "motivation",
        "oneOf": [
          "Physical health and fitness",
          "Fun and enjoyment",
          "Weight control",
          "Being outdoors in nature",
          "Social reasons",
          "Mental health"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "15–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65 and over"
      ],
      "title": "Age group (years)",
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelColor": "#5b6770",
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == '55–64'",
            "value": 700
          },
          "value": 400
        }
      }
    },
    "y": {
      "field": "motivation",
      "type": "nominal",
      "sort": [
        "Physical health and fitness",
        "Fun and enjoyment",
        "Weight control",
        "Being outdoors in nature",
        "Social reasons",
        "Mental health"
      ],
      "title": "Reason for exercising",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelColor": "#1f2a30",
        "labelPadding": 8,
        "labelLineHeight": 15,
        "titlePadding": 26,
        "labelExpr": "{\"Physical health and fitness\": [\"Physical health\", \"and fitness\"], \"Fun and enjoyment\": [\"Fun and\", \"enjoyment\"], \"Weight control\": [\"Weight\", \"control\"], \"Being outdoors in nature\": [\"Being outdoors\", \"in nature\"], \"Social reasons\": [\"Social\", \"reasons\"], \"Mental health\": [\"Mental\", \"health\"]}[datum.label]",
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == 'Being outdoors in nature'",
            "value": 700
          },
          "value": 400
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "filled": false,
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              27.1,
              74.4
            ],
            "range": [
              "#e6eaee",
              "#2f4c62"
            ],
            "interpolate": "hcl"
          },
          "legend": null
        }
      },
      "description": "Same-colour outline under each cell: fills the thin seams so the cells form one smooth surface"
    },
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "color": {
          "field": "pct",
          "type": "quantitative",
          "title": "Share of active adults (%)",
          "scale": {
            "type": "linear",
            "domain": [
              27.1,
              74.4
            ],
            "range": [
              "#e6eaee",
              "#2f4c62"
            ],
            "interpolate": "hcl"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "type": "gradient",
            "gradientLength": {
              "expr": "width"
            },
            "gradientThickness": 16,
            "gradientStrokeColor": "#9aa1a6",
            "gradientStrokeWidth": 0.5,
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "labelFlush": true,
            "offset": 16,
            "values": [
              27.1,
              74.4
            ],
            "labelExpr": "format(datum.value, '.1f') + '%'"
          }
        },
        "tooltip": [
          {
            "field": "motivation",
            "title": "Reason"
          },
          {
            "field": "age",
            "title": "Age group"
          },
          {
            "field": "pct",
            "title": "Share of active adults (%)"
          }
        ]
      },
      "description": "One cell per reason and age group; continuous slate colour, darker = a larger share; details in the tooltip"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '55–64' && datum.motivation == 'Being outdoors in nature'"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 13,
        "color": "white"
      },
      "encoding": {
        "text": {
          "value": "58%"
        }
      },
      "description": "Value written in the one cell the story is about (55 to 64, being outdoors in nature)"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Being outdoors in nature'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 4"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 14"
          }
        }
      },
      "description": "Value written in the 65 and over cell of the physical health row"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Physical health and fitness'"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 13,
        "color": "white"
      },
      "encoding": {
        "text": {
          "value": "74%"
        }
      },
      "description": "Short leader just outside the grid, pointing along the physical health row to its note"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Physical health and fitness'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 4"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 14"
          }
        }
      },
      "description": "Why note level with the physical health row"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Physical health and fitness'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "text": {
          "value": [
            "Staying healthy matters",
            "more with every age group"
          ]
        }
      },
      "description": "Short leader just outside the grid, pointing along the nature row to the note"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Being outdoors in nature'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "text": {
          "value": [
            "With children grown up, they",
            "have more time for nature"
          ]
        }
      },
      "description": "Why note to the right of the grid, level with the nature row"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 29,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Being outdoors in nature matters most at ages 55–64"
}