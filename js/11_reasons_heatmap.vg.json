{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 300,
  "data": {
    "url": "data/ausplay2025_motivations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'All adults' && datum.age != 'All ages'"
    },
    {
      "filter": {
        "field": "motivation",
        "oneOf": [
          "Physical health and fitness",
          "Fun and enjoyment",
          "Weight control",
          "Being outdoors in nature",
          "Social reasons",
          "Mental health"
        ]
      }
    },
    {
      "calculate": "datum.pct < 40 ? 0 : datum.pct < 50 ? 1 : datum.pct < 55 ? 2 : datum.pct < 60 ? 3 : datum.pct < 70 ? 4 : 5",
      "as": "pct_class"
    }
  ],
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "15–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65 and over"
      ],
      "title": "Age group (years)",
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelColor": {
          "condition": {
            "test": "datum.label == '55–64'",
            "value": "#3AA6D9"
          },
          "value": "#5b6770"
        },
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == '55–64'",
            "value": 700
          },
          "value": 400
        }
      }
    },
    "y": {
      "field": "motivation",
      "type": "nominal",
      "sort": [
        "Physical health and fitness",
        "Fun and enjoyment",
        "Weight control",
        "Being outdoors in nature",
        "Social reasons",
        "Mental health"
      ],
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelColor": "#1f2a30",
        "labelPadding": 8,
        "labelLineHeight": 15,
        "labelExpr": "{\"Physical health and fitness\": [\"Physical health\", \"and fitness\"], \"Fun and enjoyment\": [\"Fun and\", \"enjoyment\"], \"Weight control\": [\"Weight\", \"control\"], \"Being outdoors in nature\": [\"Being outdoors\", \"in nature\"], \"Social reasons\": [\"Social\", \"reasons\"], \"Mental health\": [\"Mental\", \"health\"]}[datum.label]",
        "labelFontWeight": {
          "condition": {
            "test": "datum.label == 'Being outdoors in nature'",
            "value": 700
          },
          "value": 400
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "color": {
          "field": "pct_class",
          "type": "quantitative",
          "title": "Share of active adults (%)",
          "scale": {
            "type": "threshold",
            "domain": [
              0.5,
              1.5,
              2.5,
              3.5,
              4.5
            ],
            "range": [
              "#e6eaee",
              "#c3ced6",
              "#9fb1be",
              "#7b93a5",
              "#56748b",
              "#2f4c62"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "type": "gradient",
            "gradientLength": {
              "expr": "width"
            },
            "gradientThickness": 16,
            "gradientStrokeColor": "#9aa1a6",
            "gradientStrokeWidth": 0.5,
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 400,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "labelFlush": true,
            "offset": 16,
            "labelExpr": "{'0.5': '40%', '1.5': '50%', '2.5': '55%', '3.5': '60%', '4.5': '70%'}[datum.label] || ''"
          }
        },
        "tooltip": [
          {
            "field": "motivation",
            "title": "Reason"
          },
          {
            "field": "age",
            "title": "Age group"
          },
          {
            "field": "pct",
            "title": "Share of active adults (%)"
          }
        ]
      },
      "description": "One cell per reason and age group; darker slate = a larger share (no numbers in cells, details in the tooltip)"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '55–64' && datum.motivation == 'Being outdoors in nature'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#3AA6D9",
        "strokeWidth": 3
      },
      "description": "Sky-blue outline around the 55 to 64 cell for being outdoors in nature"
    },
    {
      "transform": [
        {
          "filter": "datum.age == '65 and over' && datum.motivation == 'Being outdoors in nature'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 14"
          }
        },
        "text": {
          "value": [
            "58% at 55–64:",
            "more free time",
            "draws them outdoors"
          ]
        }
      },
      "description": "Why note to the right of the grid, on the nature row"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 24,
      "right": 150,
      "top": 8,
      "bottom": 8
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#5b6770",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#5b6770"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Being outdoors in nature matters most to 55 to 64 year-olds"
}