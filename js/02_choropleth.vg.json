  "config": {
    "background": "#e4eef3",
    "font": "\"Source Sans 3\", \"Source Sans Pro\", Helvetica, Arial, sans-serif",
    "padding": 12,
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "titleLimit": 0,
      "labelLimit": 0,
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Source Sans Pro\", Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Australian Capital Territory and Tasmania lead outdoors",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}