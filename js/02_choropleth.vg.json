{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 580,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "properties": {},
            "geometry": {
              "type": "MultiPoint",
              "coordinates": [
                [
                  111.5,
                  -9.5
                ],
                [
                  163.0,
                  -45.0
                ]
              ]
            }
          }
        ],
        "format": {
          "type": "json"
        }
      },
      "mark": {
        "type": "geoshape",
        "opacity": 0
      },
      "description": "Invisible frame: widens the map's fit into the ocean so the labels have room"
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "'Data is not available'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#dddddd",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State or territory"
          },
          {
            "field": "note",
            "title": "Share of adults (%)"
          }
        ]
      },
      "description": "Base map: every state drawn in grey from the TopoJSON file (shows 'no data' if a value were missing)"
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/state_summary_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "public_space_pct": "number",
                  "public_space_pct_2024": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "state_name",
              "public_space_pct",
              "public_space_pct_2024"
            ]
          }
        },
        {
          "calculate": "datum.public_space_pct",
          "as": "value"
        },
        {
          "calculate": "datum.value < 62 ? 'below 62' : datum.value < 64 ? '62 to 64' : datum.value < 66 ? '64 to 66' : datum.value < 68 ? '66 to 68' : '68 or more'",
          "as": "class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Share of adults (%)",
          "scale": {
            "domain": [
              61.0,
              64.0,
              68.2,
              72.8
            ],
            "range": [
              "#e3e1ef",
              "#9e9ac8",
              "#756bb1",
              "#54278f"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "type": "gradient",
            "gradientLength": {
              "expr": "width"
            },
            "gradientThickness": 16,
            "gradientStrokeColor": "#9aa1a6",
            "gradientStrokeWidth": 0.5,
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "labelFlush": true,
            "offset": 16,
            "values": [
              61.0,
              72.8
            ],
            "labelExpr": "format(datum.value, '.1f') + '%'"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State or territory"
          },
          {
            "field": "value",
            "title": "Share of adults (%)",
            "format": ".1f"
          }
        ]
      },
      "description": "Data layer: lookup joins the data table to the map by state name, then colour = share of adults in 5 classes (lighter = lower)"
    },
    {
      "data": {
