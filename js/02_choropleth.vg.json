      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/state_summary_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "public_space_pct": "number",
                  "public_space_pct_2024": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "state_name",
              "public_space_pct",
              "public_space_pct_2024"
            ]
          }
        },
        {
          "calculate": "datum.public_space_pct",
          "as": "value"
        },
        {
          "calculate": "datum.value < 62 ? 'below 62' : datum.value < 64 ? '62 to 64' : datum.value < 66 ? '64 to 66' : datum.value < 68 ? '66 to 68' : '68 or more'",
          "as": "class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [
              61.0,
              64.0,
              68.2,
              72.8
            ],
            "range": [
              "#e3e1ef",
              "#9e9ac8",
              "#756bb1",
              "#54278f"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State or territory (enlarged 6 times)"
          },
          {
            "field": "value",
            "title": "Share of adults (%)",
            "format": ".1f"
          }
        ]
      },
      "description": "Enlarged copy of the Capital Territory (6 times bigger) in the Tasman Sea, coloured by the same lookup and scale"
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.45,
            "lat": -35.55,
            "lon2": 155.1,
            "lat2": -38.300000000000004,
            "dash": 1
          },
          {
            "lon": 145.15,
            "lat": -41.0,
            "lon2": 144.3,
            "lat2": -41.0,
            "dash": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "strokeDash": {
          "field": "dash",
          "type": "nominal",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              [
                1,
                0
              ],
              [
                4,
                3
              ]
            ]
          },
          "legend": null
        }
      },
      "description": "Dashed line from the real Capital Territory to its enlarged copy, and a short line to the Tasmania label"
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/state_summary_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "public_space_pct": "number",
            "public_space_pct_2024": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state == 'ACT'"
        },
        {
          "calculate": "datum.public_space_pct",
          "as": "value"
        },
        {
          "calculate": "154.4",
          "as": "lab_lon"
        },
        {
          "calculate": "-31.0",
          "as": "lab_lat"
        },
        {
          "calculate": "datum.state == 'ACT' ? ['Australian Capital', 'Territory ' + format(datum.value, '.0f') + '% (enlarged)'] : [datum.state_name + ' ' + format(datum.value, '.0f') + '%']",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 700,
        "lineHeight": 16
      },
      "encoding": {
        "longitude": {
          "field": "lab_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lab_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Capital Territory label above its enlarged copy"
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/state_summary_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "public_space_pct": "number",
            "public_space_pct_2024": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state == 'TAS'"
        },
        {
          "calculate": "datum.public_space_pct",
          "as": "value"
        },
        {
          "calculate": "datum.state_name + ' ' + format(datum.value, '.0f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 700,
        "dx": -3
      },
      "encoding": {
        "longitude": {
          "datum": 144.3
        },
        "latitude": {
          "datum": -41.0
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Tasmania label, in the ocean to the west"
    },
    {
      "data": {
        "values": [
          {
            "lon": 154.4,
            "lat": -33.4,
            "why": [
              "Bush capital: nature reserves",
              "sit beside the suburbs"
            ]
          },
          {
            "lon": 144.3,
            "lat": -41.5,
            "why": [
              "Much of the island",
              "is national park"
            ],
            "al": "right"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.al == 'right' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.al == 'right' ? -3 : 0"
        },
        "baseline": "top",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "why"
        }
      },
      "description": "Why notes under the two labels"
    }
