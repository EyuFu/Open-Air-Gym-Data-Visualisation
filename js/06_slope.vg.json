{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 975,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/ausplay2025_outdoor_activity_by_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.sex == 'Women' ? datum.pct : null",
      "as": "w"
    },
    {
      "calculate": "datum.sex == 'Men' ? datum.pct : null",
      "as": "m"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "w",
          "as": "women_pct"
        },
        {
          "op": "max",
          "field": "m",
          "as": "men_pct"
        }
      ],
      "groupby": [
        "activity"
      ]
    },
    {
      "calculate": "datum.activity == 'Running and jogging' && datum.sex == 'Men' ? -6 : datum.activity == 'Bushwalking' && datum.sex == 'Men' ? 6 : 0",
      "as": "nudge"
    },
    {
      "calculate": "datum.pct - datum.nudge / 5.5",
      "as": "label_y"
    },
    {
      "calculate": "datum.sex == 'Women' ? 0 : 1",
      "as": "side"
    }
  ],
  "encoding": {
    "x": {
      "field": "side",
      "type": "quantitative",
      "title": "Sex",
      "scale": {
        "domain": [
          -0.06,
          1.21
        ]
      },
      "axis": {
        "orient": "top",
        "values": [
          0,
          1
        ],
        "labelExpr": "datum.value == 0 ? 'Women' : 'Men'",
        "grid": false,
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelColor": "#1f2a30",
        "domain": false,
        "ticks": false,
        "labelPadding": 10
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          60
        ]
      },
      "axis": null
    },
    "detail": {
      "field": "activity"
    },
    "color": {
      "field": "activity",
      "type": "nominal",
      "scale": {
        "domain": [
          "Walking for exercise",
          "Bushwalking",
          "Running and jogging",
          "Cycling"
        ],
        "range": [
          "#009E73",
          "#8B5A2B",
          "#CC79A7",
          "#D9A400"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleOrient": "top",
        "titleAnchor": "start",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#1f2a30",
        "titlePadding": 6,
        "labelFontSize": 13,
        "labelColor": "#5b6770",
        "symbolType": "square",
        "symbolSize": 180,
        "symbolStrokeWidth": 0,
        "gridAlign": "none",
        "columnPadding": 32,
        "labelOffset": 6,
        "offset": 16,
        "title": "Activity (click to highlight)",
        "labelExpr": "{'Walking for exercise': 'Walking', 'Running and jogging': 'Running', 'The other three, for comparison': 'The other three'}[datum.label] || datum.label"
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "sex": "Women",
            "side": 0
          },
          {
            "sex": "Men",
            "side": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "value": 0
        },
        "y2": {
          "value": 330
        },
        "color": {
          "value": "#d5d9dc"
        },
        "detail": {
          "field": "sex"
        }
      },
      "description": "Thin grey vertical axis line under Women and under Men"
    },
    {
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "activity"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1,
            "empty": true
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "women_pct",
            "title": "Women (%)"
          },
          {
            "field": "men_pct",
            "title": "Men (%)"
          }
        ]
      },
      "description": "One line per activity from women to men, each activity in its own colour, same scale on both sides"
    },
    {
      "mark": {
        "type": "circle",
        "size": 70
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1,
            "empty": true
          },
          "value": 0.15
        }
      },
      "description": "Dots at both ends"
    },
    {
      "transform": [
        {
          "filter": "datum.sex == 'Men'"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%  ' + datum.activity",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "lab"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1,
            "empty": true
          },
          "value": 0.15
        },
        "color": {
          "condition": [
            {
              "test": "datum.activity == 'Walking for exercise'",
              "value": "#007a59"
            },
            {
              "test": "datum.activity == 'Bushwalking'",
              "value": "#8B5A2B"
            },
            {
              "test": "datum.activity == 'Running and jogging'",
              "value": "#a3487f"
            },
            {
              "test": "datum.activity == 'Cycling'",
              "value": "#8a6600"
            }
          ],
          "value": "#6b7378"
        }
      },
      "description": "Men's value and activity name on the right"
    },
    {
      "transform": [
        {
          "filter": "datum.sex == 'Women'"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "lab"
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1,
            "empty": true
          },
          "value": 0.15
        },
        "color": {
          "condition": [
            {
              "test": "datum.activity == 'Walking for exercise'",
              "value": "#007a59"
            },
            {
              "test": "datum.activity == 'Bushwalking'",
              "value": "#8B5A2B"
            },
            {
              "test": "datum.activity == 'Running and jogging'",
              "value": "#a3487f"
            },
            {
              "test": "datum.activity == 'Cycling'",
              "value": "#8a6600"
            }
          ],
          "value": "#6b7378"
        }
      },
      "description": "Women's value on the left"
    },
    {
      "data": {
        "values": [
          {
            "sex": "Women",
            "side": 0,
            "pct": 50.5,
            "activity": "note"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 14,
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "text": {
          "value": [
            "Walking is cheap and social,",
            "and fits around caring for family"
          ]
        },
        "color": {
          "value": "#3d4a52"
        }
      },
      "description": "Why note about walking, right beside the women's walking dot"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "\"Source Sans 3\", \"Source Sans Pro\", Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 0,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Source Sans Pro\", Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Women walk more; men run and cycle more"
}