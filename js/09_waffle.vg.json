{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/ausplay2025_frequency.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "pct": "number",
        "squares": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(1, datum.squares + 1)",
      "as": "unit"
    },
    {
      "flatten": [
        "unit"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "cell"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "unit"
        }
      ]
    },
    {
      "calculate": "(datum.cell - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.cell - 1) / 10)",
      "as": "row"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "color": {
          "field": "frequency",
          "type": "nominal",
          "scale": {
            "domain": [
              "3 or more times a week",
              "Once or twice a week",
              "Less than once a week",
              "Not active in the past year"
            ],
            "range": [
              "#4d5a61",
              "#8a9096",
              "#bdbdbd",
              "#e3e1dc"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 400,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 170,
            "symbolStrokeWidth": 0,
            "gridAlign": "all",
            "columnPadding": 70,
            "offset": 56,
            "title": "How often adults are active",
            "columns": 1,
            "labelExpr": "{'3 or more times a week': '50%  3 or more a week', 'Once or twice a week': '19%  Once or twice a week', 'Less than once a week': '17%  Less than weekly', 'Not active in the past year': '14%  Not active'}[datum.label]"
          }
        },
        "tooltip": [
          {
            "field": "frequency",
            "title": "How often"
          },
          {
            "field": "pct",
            "title": "Share of adults (%)"
          }
        ]
      },
      "description": "10 by 10 grid: one square = 1% of adults, coloured by how often they are active"
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 12,
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": {
            "expr": "height + 12"
          }
        },
        "text": {
          "value": [
            "Not active: mainly poor health",
            "or feeling too old (chart 12)"
          ]
        }
      },
      "description": "Label for group 1"
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 60"
          }
        },
        "y": {
          "value": {
            "expr": "height + 10"
          }
        },
        "x2": {
          "value": {
            "expr": "width - 60"
          }
        },
        "y2": {
          "value": {
            "expr": "height - 8"
          }
        }
      },
      "description": "Label for group 2"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 4,
      "top": 8,
      "bottom": 8
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 12,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Half of all adults are active three or more times a week"
}