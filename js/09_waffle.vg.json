{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 380,
  "data": {
    "url": "data/ausplay2025_frequency.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "pct": "number",
        "squares": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(1, datum.squares + 1)",
      "as": "unit"
    },
    {
      "flatten": [
        "unit"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "cell"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "unit"
        }
      ]
    },
    {
      "calculate": "(datum.cell - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.cell - 1) / 10)",
      "as": "row"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "color": {
          "field": "frequency",
          "type": "nominal",
          "scale": {
            "domain": [
              "3 or more times a week",
              "Once or twice a week",
              "Less than once a week",
              "Not active in the past year"
            ],
            "range": [
              "#7D7F27",
              "#a9ab5e",
              "#cfd09b",
              "#e9e9d0"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "frequency",
            "title": "How often"
          },
          {
            "field": "pct",
            "title": "Share of adults (%)"
          }
        ]
      },
      "description": "10 by 10 grid: one square = 1% of adults, coloured by how often they are active"
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
