{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "city",
      "value": "Melbourne",
      "bind": {
        "input": "select",
        "options": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Hobart",
          "Darwin",
          "Canberra"
        ],
        "name": "Capital city: "
      }
    }
  ],
  "data": {
    "url": "data/bom_capital_climate_monthly_means.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month_num": "number",
        "mean_max_temp_c": "number",
        "mean_rainfall_mm": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "[\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"][datum.month_num - 1]",
      "as": "month_name"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#1b9e77",
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y": {
          "datum": 15
        },
        "y2": {
          "datum": 25
        }
      },
      "description": "Light teal band from 15 to 25 degrees: mild days"
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 4,
        "dy": -3,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#0f7a5b"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "datum": 15
        },
        "text": {
          "value": "Mild: 15 to 25°C"
        }
      },
      "description": "Label for the band"
    },
    {
      "transform": [
        {
          "filter": "datum.city != city"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#cfcfcf",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 11,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": null,
          "axis": {
            "values": [
              10,
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        },
        "detail": {
          "field": "city"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "mean_max_temp_c",
            "title": "Average maximum (°C)"
          }
        ]
      },
      "description": "The other seven cities as thin grey lines"
    },
    {
      "transform": [
        {
          "filter": "datum.city == city"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#1b9e77",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 11,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": null,
          "axis": {
            "values": [
              10,
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        }
      },
      "description": "The chosen city as a thick teal line"
    },
    {
      "transform": [
        {
          "filter": "datum.city == city"
        },
        {
          "calculate": "datum.mean_max_temp_c >= 15 && datum.mean_max_temp_c <= 25 ? 'Mild' : 'Not mild'",
          "as": "mild"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 60,
        "strokeWidth": 2,
        "color": "#1b9e77",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 11,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": null,
          "axis": {
            "values": [
              10,
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        },
        "fill": {
          "field": "mild",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Mild",
              "Not mild"
            ],
            "range": [
              "#1b9e77",
              "white"
            ]
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "mean_max_temp_c",
            "title": "Average maximum (°C)"
          },
          {
            "field": "mild",
            "title": "Mild (15 to 25°C)?"
          },
          {
            "field": "mean_rainfall_mm",
            "title": "Average rainfall (millimetres)"
          }
        ]
      },
      "description": "One dot per month: filled = mild, hollow = not mild"
    },
    {
      "data": {
        "values": [
          {
            "c": "Melbourne",
            "lab": [
              "Melbourne: mild in spring and autumn;",
              "winter days fall below 15°C"
            ]
          },
          {
            "c": "Sydney",
            "lab": [
              "Sydney: the ocean keeps",
              "nine months mild"
            ]
          },
          {
            "c": "Brisbane",
            "lab": [
              "Brisbane: subtropical, so only",
              "winter (May to August) is mild"
            ]
          },
          {
            "c": "Perth",
            "lab": [
              "Perth: hot, dry summers;",
              "May to October is mild"
            ]
          },
          {
            "c": "Adelaide",
            "lab": [
              "Adelaide: hot, dry summers;",
              "eight mild months"
            ]
          },
          {
            "c": "Hobart",
            "lab": [
              "Hobart: far south, so even",
              "summer stays mild"
            ]
          },
          {
            "c": "Darwin",
            "lab": [
              "Darwin: tropical, above 30°C all year,",
              "so exercise at dawn or dusk"
            ]
          },
          {
            "c": "Canberra",
            "lab": [
              "Canberra: inland, with hot summers",
              "and cold winters"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.c == city"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "fontStyle": "italic",
        "color": "#3d4a52",
        "dx": 4
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "datum": 38
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Why note for the chosen city"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 8,
      "right": 12,
      "top": 8,
      "bottom": 8
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 11,
      "labelColor": "#5b6770",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#5b6770"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 12
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Mild months differ by city: pick yours",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}