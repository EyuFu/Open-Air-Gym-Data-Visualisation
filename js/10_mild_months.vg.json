{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 300,
  "params": [
    {
      "name": "city",
      "value": "Melbourne",
      "bind": {
        "input": "select",
        "options": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Hobart",
          "Darwin",
          "Canberra"
        ],
        "name": "Capital city: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/bom_capital_climate_monthly_means.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month_num": "number",
        "mean_max_temp_c": "number",
        "mean_rainfall_mm": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "[\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"][datum.month_num - 1]",
      "as": "month_name"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#9aa1a6",
        "opacity": 0.16
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y": {
          "datum": 15,
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          }
        },
        "y2": {
          "datum": 25
        }
      },
      "description": "Light grey band from 15 to 25 degrees: mild days"
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 4,
        "dy": -3,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#5b6770"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "datum": 15,
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          }
        },
        "text": {
          "value": "Mild: 15 to 25°C"
        }
      },
      "description": "Label for the band"
    },
    {
      "transform": [
        {
          "filter": "datum.city != city"
        },
        {
          "calculate": "'Other cities'",
          "as": "line_role"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": "Month",
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": "Average daily maximum (°C)",
          "axis": {
            "values": [
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        },
        "detail": {
          "field": "city"
        },
        "color": {
          "field": "line_role",
          "type": "nominal",
          "scale": {
            "domain": [
              "Chosen city",
              "Other cities"
            ],
            "range": [
              "#E6550D",
              "#cfcfcf"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 50,
            "symbolStrokeWidth": 7,
            "gridAlign": "all",
            "columnPadding": 40,
            "offset": 16,
            "title": "Line colour",
            "legendX": 0,
            "legendY": 334
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "mean_max_temp_c",
            "title": "Average maximum (°C)"
          }
        ]
      },
      "description": "The other seven cities as thin grey lines"
    },
    {
      "transform": [
        {
          "filter": "datum.city == city"
        },
        {
          "calculate": "'Chosen city'",
          "as": "line_role"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": "Month",
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": "Average daily maximum (°C)",
          "axis": {
            "values": [
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        },
        "color": {
          "field": "line_role",
          "type": "nominal",
          "scale": {
            "domain": [
              "Chosen city",
              "Other cities"
            ],
            "range": [
              "#E6550D",
              "#cfcfcf"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 50,
            "symbolStrokeWidth": 7,
            "gridAlign": "all",
            "columnPadding": 40,
            "offset": 16,
            "title": "Line colour",
            "legendX": 0,
            "legendY": 334
          }
        }
      },
      "description": "The chosen city as a thick orange line"
    },
    {
      "transform": [
        {
          "filter": "datum.city == city"
        },
        {
          "calculate": "datum.mean_max_temp_c >= 15 && datum.mean_max_temp_c <= 25 ? 'Mild' : 'Not mild'",
          "as": "mild"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 60,
        "strokeWidth": 2,
        "color": "#E6550D",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": "Month",
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "mean_max_temp_c",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          },
          "title": "Average daily maximum (°C)",
          "axis": {
            "values": [
              15,
              20,
              25,
              30,
              35
            ],
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.value + '°C'"
          }
        },
        "fill": {
          "field": "mild",
          "type": "nominal",
          "scale": {
            "domain": [
              "Mild",
              "Not mild"
            ],
            "range": [
              "#E6550D",
              "white"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 180,
            "symbolStrokeWidth": 2,
            "gridAlign": "all",
            "columnPadding": 40,
            "offset": 16,
            "title": "Dot",
            "legendX": 0,
            "legendY": 384,
            "symbolStrokeColor": "#E6550D",
            "labelExpr": "datum.label == 'Mild' ? 'Mild month' : 'Not mild'"
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "mean_max_temp_c",
            "title": "Average maximum (°C)"
          },
          {
            "field": "mild",
            "title": "Mild (15 to 25°C)?"
          },
          {
            "field": "mean_rainfall_mm",
            "title": "Average rainfall (millimetres)"
          }
        ]
      },
      "description": "One dot per month: filled = mild, hollow = not mild"
    },
    {
      "data": {
        "values": [
          {
            "c": "Melbourne",
            "lab": [
              "Melbourne: mild in spring and autumn;",
              "winter days fall below 15°C"
            ]
          },
          {
            "c": "Sydney",
            "lab": [
              "Sydney: the ocean keeps",
              "nine months mild"
            ]
          },
          {
            "c": "Brisbane",
            "lab": [
              "Brisbane: subtropical, so only",
              "winter (May to August) is mild"
            ]
          },
          {
            "c": "Perth",
            "lab": [
              "Perth: hot, dry summers;",
              "May to October is mild"
            ]
          },
          {
            "c": "Adelaide",
            "lab": [
              "Adelaide: hot, dry summers;",
              "eight mild months"
            ]
          },
          {
            "c": "Hobart",
            "lab": [
              "Hobart: far south, so even",
              "summer stays mild"
            ]
          },
          {
            "c": "Darwin",
            "lab": [
              "Darwin: tropical, above 30°C all year,",
              "so exercise at dawn or dusk"
            ]
          },
          {
            "c": "Canberra",
            "lab": [
              "Canberra: inland, with hot summers",
              "and cold winters"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.c == city"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "lineHeight": 16,
        "fontStyle": "italic",
        "color": "#3d4a52",
        "dx": 4
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "datum": 38,
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          }
        },
        "text": {
          "field": "lab"
        }
      },
      "description": "Why note for the chosen city"
    },
    {
      "transform": [
        {
          "filter": "datum.city == city"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "mean_max_temp_c",
              "as": "coolest"
            }
          ]
        },
        {
          "filter": "datum.mean_max_temp_c == datum.coolest"
        },
        {
          "calculate": "35",
          "as": "top"
        },
        {
          "calculate": "datum.mean_max_temp_c + 0.9",
          "as": "bottom"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "month_num",
          "type": "ordinal",
          "title": "Month",
          "scale": {
            "padding": 0.3
          },
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelExpr": "datum.value == 1 ? 'January' : datum.value == 4 ? 'April' : datum.value == 7 ? 'July' : datum.value == 10 ? 'October' : ''"
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              38
            ],
            "nice": false
          }
        },
        "y2": {
          "field": "bottom"
        }
      },
      "description": "Leader line from the note down to the chosen city's coolest month"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 4,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Mild months differ by city: pick yours"
}