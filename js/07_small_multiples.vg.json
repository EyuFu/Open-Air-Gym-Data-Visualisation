{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/ausplay2025_activity_by_age.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "activity",
        "oneOf": [
          "Walking for exercise",
          "Bushwalking",
          "Running and jogging",
          "Cycling"
        ]
      }
    },
    {
      "calculate": "[\"Walking for exercise\", \"Bushwalking\", \"Running and jogging\", \"Cycling\"]",
      "as": "panel"
    },
    {
      "flatten": [
        "panel"
      ]
    },
    {
      "calculate": "datum.panel == datum.activity",
      "as": "is_self"
    },
    {
      "calculate": "datum.is_self ? datum.activity : 'The other three, for comparison'",
      "as": "role"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "pct",
          "as": "peak"
        }
      ],
      "groupby": [
        "panel",
        "activity"
      ]
    }
  ],
  "facet": {
    "field": "panel",
    "type": "nominal",
    "sort": [
      "Walking for exercise",
      "Bushwalking",
      "Running and jogging",
      "Cycling"
    ],
    "title": null,
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30",
      "labelAnchor": "start",
      "labelPadding": 6
    }
  },
  "columns": 4,
  "spec": {
    "width": 150,
    "height": 160,
    "encoding": {
      "x": {
        "field": "age",
        "type": "ordinal",
        "sort": [
          "15–17",
          "18–24",
          "25–34",
          "35–44",
          "45–54",
          "55–64",
          "65 and over"
        ],
        "title": "Age group (years)",
        "scale": {
          "padding": 0.1
        },
        "axis": {
          "ticks": false,
          "labelAngle": 0,
          "labelFlush": true,
          "labelFontSize": 13,
          "labelOverlap": false,
          "labelExpr": "datum.label == '15–17' ? 'Age 15' : datum.label == '65 and over' ? '65 and over' : ''"
        }
      },
      "y": {
        "field": "pct",
        "type": "quantitative",
        "scale": {
          "domain": [
            0,
            80
          ]
        },
        "title": "Share of adults (%)",
        "axis": {
          "values": [
            0,
            40,
            80
          ],
          "ticks": false,
          "domain": false,
          "labelPadding": 8,
          "labelExpr": "datum.value + '%'"
        }
      }
    },
    "layer": [
      {
        "transform": [
          {
            "filter": "datum.is_self"
          }
        ],
        "mark": {
          "type": "line",
          "strokeWidth": 3,
          "point": {
            "size": 22,
            "filled": true
          }
        },
        "encoding": {
          "color": {
            "field": "role",
            "type": "nominal",
            "scale": {
              "domain": [
                "Walking for exercise",
                "Bushwalking",
                "Running and jogging",
                "Cycling"
              ],
              "range": [
                "#009E73",
                "#8B5A2B",
                "#CC79A7",
                "#D9A400"
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "titleOrient": "top",
              "titleAnchor": "start",
              "titleFontSize": 13,
              "titleFontWeight": 600,
              "titleColor": "#1f2a30",
              "titlePadding": 6,
              "labelFontSize": 13,
              "labelColor": "#5b6770",
              "symbolType": "square",
              "symbolSize": 180,
              "symbolStrokeWidth": 0,
              "gridAlign": "all",
              "columnPadding": 24,
              "offset": 16,
              "title": "Line colour",
              "labelExpr": "{'Walking for exercise': 'Walking', 'Running and jogging': 'Running', 'The other three, for comparison': 'The other three'}[datum.label] || datum.label"
            }
          },
          "tooltip": [
            {
              "field": "activity",
              "title": "Activity"
            },
            {
              "field": "age",
              "title": "Age group"
            },
            {
              "field": "pct",
              "title": "Share of adults (%)"
            }
          ]
        },
        "description": "One line per panel: the panel's own activity in its own colour; all panels share the same scales"
      },
      {
        "transform": [
          {
            "filter": "datum.is_self && datum.activity == 'Running and jogging' && datum.age == '15–17'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "dx": -4,
          "fontStyle": "italic",
          "color": "#3d4a52",
          "fontSize": 13,
          "lineHeight": 16
        },
        "encoding": {
          "y": {
            "datum": 79
          },
          "text": {
            "value": [
              "Hard on the knees, so many",
              "runners switch to walking"
            ]
          }
        },
        "description": "Why note in the running panel"
      },
      {
        "transform": [
          {
            "filter": "datum.is_self && datum.activity == 'Running and jogging' && datum.age == '45–54'"
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#8a9096",
          "strokeWidth": 1
        },
        "encoding": {
          "y": {
            "datum": 63
          },
          "y2": {
            "datum": 19
          }
        },
        "description": "Leader line from the note down to the falling running line"
      },
      {
        "transform": [
          {
            "filter": "datum.is_self && datum.pct == datum.peak"
          },
          {
            "calculate": "'Peak ' + format(datum.pct, '.0f') + '%'",
            "as": "lab"
          }
        ],
        "mark": {
          "type": "text",
          "dy": -11,
          "fontSize": 13,
          "fontWeight": 700
        },
        "encoding": {
          "text": {
            "field": "lab"
          },
          "color": {
            "condition": [
              {
                "test": "datum.role == 'Walking for exercise'",
                "value": "#007a59"
              },
              {
                "test": "datum.role == 'Bushwalking'",
                "value": "#8B5A2B"
              },
              {
                "test": "datum.role == 'Running and jogging'",
                "value": "#a3487f"
              },
              {
                "test": "datum.role == 'Cycling'",
                "value": "#8a6600"
              }
            ],
            "value": "#6b7378"
          }
        },
        "description": "Label at the peak of each panel's line"
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "shared",
      "x": "shared"
    }
  },
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 4,
      "right": 7,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    },
    "facet": {
      "spacing": {
        "row": 20,
        "column": 34
      }
    }
  },
  "description": "Walking grows with age; running fades after 35"
}