      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      },
      "description": "Why note under the Australian Capital Territory callout"
    },
    {
      "data": {
        "url": "https://eyufu.github.io/Open-Air-Gym-Data-Visualisation/data/state_summary_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "centroid_lon": "number",
            "centroid_lat": "number",
            "outdoor_stations_per_100k": "number",
            "osm_outdoor_stations": "number",
            "population_2026q1": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.state == 'ACT' ? 157.0 : datum.centroid_lon",
          "as": "plon"
        },
        {
          "calculate": "datum.state == 'ACT' ? -38.6 : datum.centroid_lat",
          "as": "plat"
        },
        {
          "calculate": "datum.outdoor_stations_per_100k < 6 ? 'below 6' : datum.outdoor_stations_per_100k < 9 ? '6 to 9' : datum.outdoor_stations_per_100k < 12 ? '9 to 12' : '12 or more'",
          "as": "rate_class"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#14285f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        },
        "size": {
          "field": "osm_outdoor_stations",
          "type": "quantitative",
          "title": "Mapped outdoor stations",
          "scale": {
            "range": [
              0,
              2400
            ],
            "domain": [
              0,
              800
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              100,
              400,
              800
            ],
            "symbolFillColor": "#ffffff",
            "symbolStrokeColor": "#14285f",
            "symbolStrokeWidth": 1
          }
        },
        "color": {
          "field": "rate_class",
          "type": "ordinal",
          "title": "Stations per 100,000 people",
          "scale": {
            "domain": [
              "below 6",
              "6 to 9",
              "9 to 12",
              "12 or more"
            ],
            "range": [
              "#aab8e0",
              "#7088c9",
              "#3f5bb0",
              "#1F3A93"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 420,
            "symbolStrokeColor": "#14285f",
            "symbolStrokeWidth": 1
          }
        },
        "order": {
          "field": "osm_outdoor_stations",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State or territory"
          },
          {
            "field": "osm_outdoor_stations",
            "title": "Mapped outdoor stations"
          },
          {
            "field": "population_2026q1",
            "title": "Population",
            "format": ","
          },
          {
            "field": "outdoor_stations_per_100k",
            "title": "Stations per 100,000 people"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://eyufu.github.io/Open-Air-Gym-Data-Visualisation/data/state_summary_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "outdoor_stations_per_100k": "number",
            "osm_outdoor_stations": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state == 'ACT' || datum.state == 'NSW'"
        },
        {
          "calculate": "datum.state == 'ACT' ? 154.4 : 154.5",
          "as": "lab_lon"
        },
        {
          "calculate": "datum.state == 'ACT' ? -30.6 : -24.6",
          "as": "lab_lat"
        },
        {
          "calculate": "datum.state == 'ACT' ? ['Australian Capital Territory', '(enlarged): ' + format(datum.outdoor_stations_per_100k, '.1f') + ' per 100,000'] : ['New South Wales:', 'most stations,', format(datum.osm_outdoor_stations, ',') + ' in total']",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "lineHeight": 15,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lab_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lab_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    },
