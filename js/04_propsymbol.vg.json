    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2a30"
    }
  },
  "description": "New South Wales has the most stations; per person, the Australian Capital Territory leads",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
