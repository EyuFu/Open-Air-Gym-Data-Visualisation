{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 670,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/EyuFu/Open-Air-Gym-Data-Visualisation/main/data/ausplay2025_barriers.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'All adults' && datum.age != 'All ages'"
    },
    {
      "filter": {
        "field": "barrier",
        "oneOf": [
          "Poor health or injury",
          "Increasing age/ too old",
          "Too lazy",
          "Disability",
          "Don’t like sport/physical activity",
          "Not enough time/ too many other commitments",
          "Not a priority",
          "Nobody to do it with",
          "Can't afford it",
          "The weather"
        ]
      }
    },
    {
      "calculate": "{\"Poor health or injury\": \"Poor health or injury\", \"Increasing age/ too old\": \"Feeling too old\", \"Too lazy\": \"Feeling too lazy\", \"Disability\": \"Disability\", \"Don\\u2019t like sport/physical activity\": \"Not liking exercise\", \"Not enough time/ too many other commitments\": \"Not enough time\", \"Not a priority\": \"Not a priority\", \"Nobody to do it with\": \"Nobody to go with\", \"Can't afford it\": \"Cannot afford it\", \"The weather\": \"The weather\"}[datum.barrier]",
      "as": "reason"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "pct",
          "as": "age_top"
        }
      ],
      "groupby": [
        "age"
      ]
    },
    {
      "calculate": "datum.pct == datum.age_top",
      "as": "is_top"
    },
    {
      "calculate": "datum.is_top ? 'Top reason for that age' : 'Other reasons'",
      "as": "top_role"
    }
  ],
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "15–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65 and over"
      ],
      "title": "Age group (years)",
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 13
      }
    },
    "y": {
      "field": "reason",
      "type": "nominal",
      "sort": [
        "Poor health or injury",
        "Feeling too old",
        "Feeling too lazy",
        "Disability",
        "Not liking exercise",
        "Not enough time",
        "Not a priority",
        "Nobody to go with",
        "Cannot afford it",
        "The weather"
      ],
      "title": "Reason for not exercising",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelColor": "#1f2a30",
        "labelPadding": 8,
        "titlePadding": 14
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "reason": "Feeling too old",
            "age": "65 and over"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#8a9096",
        "strokeWidth": 1
      },
      "encoding": {
        "x2": {
          "value": {
            "expr": "width + 14"
          }
        }
      },
      "description": "Leader line from the 'feeling too old' note to its circle (drawn first, so the circles sit on top)"
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1
      },
      "encoding": {
        "size": {
          "field": "pct",
          "type": "quantitative",
          "title": "Share of inactive adults (%)",
          "scale": {
            "domain": [
              0,
              50
            ],
            "range": [
              0,
              1300
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 400,
            "legendY": 398,
            "direction": "horizontal",
            "values": [
              10,
              25,
              50
            ],
            "symbolFillColor": "#9aa1a6",
            "symbolStrokeWidth": 0,
            "labelExpr": "datum.value + '%'",
            "titleOrient": "top",
            "titleAnchor": "start"
          }
        },
        "color": {
          "field": "top_role",
          "type": "nominal",
          "scale": {
            "domain": [
              "Top reason for that age",
              "Other reasons"
            ],
            "range": [
              "#B5173F",
              "#c3c7ca"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#1f2a30",
            "titlePadding": 6,
            "labelFontSize": 13,
            "labelColor": "#5b6770",
            "symbolType": "square",
            "symbolSize": 180,
            "symbolStrokeWidth": 0,
            "gridAlign": "all",
            "columnPadding": 40,
            "offset": 16,
            "title": "Circle colour",
            "legendX": 0,
            "legendY": 402
          }
        },
        "tooltip": [
          {
            "field": "reason",
            "title": "Reason"
          },
          {
            "field": "age",
            "title": "Age group"
          },
          {
            "field": "pct",
            "title": "Share of inactive adults (%)"
          }
        ]
      },
      "description": "One circle per reason and age group: circle area = share (size scale starts at 0); red = the top reason for that age"
    },
    {
      "transform": [
        {
          "filter": "datum.is_top"
        },
        {
          "calculate": "format(datum.pct, '.0f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "white"
      },
      "encoding": {
        "text": {
          "field": "lab"
        }
      },
      "description": "Value label inside each red circle"
    },
    {
      "data": {
        "values": [
          {
            "reason": "Feeling too lazy",
            "why": [
              "Screens and study take over",
              "once school sport ends"
            ]
          },
          {
            "reason": "Feeling too old",
            "why": [
              "Bodies grow weaker with age"
            ]
          },
          {
            "reason": "Not enough time",
            "why": [
              "Work and young children leave",
              "little spare time at 35–44"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 18,
        "fontStyle": "italic",
        "color": "#3d4a52",
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "value": "width"
        },
        "y": {
          "field": "reason",
          "type": "nominal"
        },
        "text": {
          "field": "why"
        }
      },
      "description": "Why notes beside three rows, outside the grid"
    }
  ],
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
    "padding": {
      "left": 6,
      "right": 29,
      "top": 12,
      "bottom": 5
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 700,
      "color": "#1f2a30",
      "offset": 16,
      "subtitleFontSize": 14,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5b6770",
      "subtitlePadding": 8
    },
    "view": {
      "stroke": null
    },
    "mark": {
      "aria": false
    },
    "axis": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30",
      "domainColor": "#c8c8c8",
      "tickColor": "#c8c8c8",
      "grid": false
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#5b6770",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#1f2a30"
    },
    "text": {
      "font": "Source Sans 3, Source Sans Pro, Helvetica, Arial, sans-serif",
      "color": "#1f2a30",
      "fontSize": 13
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#1f2a30"
    }
  },
  "description": "Youth feel too lazy; older people face poor health"
}